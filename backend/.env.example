PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/attendanceDB?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
QR_EXPIRY_MINUTES=5

# REQUIRED for split deploy — exact frontend URL (no trailing slash)
# Comma-separate multiple: production + preview URLs
FRONTEND_ORIGIN=https://qr-code-frontend-black.vercel.app

# Optional — Railway Python QR fallback
# PYTHON_QR_SERVICE_URL=https://your-service.up.railway.app
